// ─────────────────────────────────────
// UltrasonicSensor
// ─────────────────────────────────────
class UltrasonicSensor {
  int trig, echo;

public:
  UltrasonicSensor(int trig, int echo) : trig(trig), echo(echo) {}

  void begin() {
    pinMode(trig, OUTPUT);
    pinMode(echo, INPUT);
  }

  long getDistance() {
    digitalWrite(trig, LOW);
    delayMicroseconds(2);
    digitalWrite(trig, HIGH);
    delayMicroseconds(10);
    digitalWrite(trig, LOW);

    // Timeout set to 15000us (prevents hardware lockups on clones, 
    // but fast enough to not block the main loop)
    long duration = pulseIn(echo, HIGH, 15000);

    if (duration == 0) {
      return 0;
    }

    return duration * 0.034 / 2;
  }
};

// ─────────────────────────────────────
// IRSensor
// ─────────────────────────────────────
class IRSensor {
  int pin;

public:
  IRSensor(int pin) : pin(pin) {}

  void begin() {
    pinMode(pin, INPUT);
  }

  // TRUE = WHITE
  // FALSE = BLACK
  bool onLine() {
    return digitalRead(pin) == LOW;
  }
};

// ─────────────────────────────────────
// Motor
// ─────────────────────────────────────
class Motor {
  int en, in1, in2;

public:
  Motor(int en, int in1, int in2) : en(en), in1(in1), in2(in2) {}

  void begin() {
    pinMode(en,  OUTPUT);
    pinMode(in1, OUTPUT);
    pinMode(in2, OUTPUT);
  }

  void forward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  }

  void backward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
  }

  void stop() {
    analogWrite(en, 0);
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }
};

// ─────────────────────────────────────
// Car
// ─────────────────────────────────────
class Car {
  Motor            leftMotor;
  Motor            rightMotor;
  IRSensor         leftIR;
  IRSensor         rightIR;
  UltrasonicSensor rightSonar;
  UltrasonicSensor leftSonar;

  // --- TUNING ---
  static const int SPEED      = 130;
  static const int TURN_SPEED = 120;
  static const int STOP_DIST  = 17;

  // Speeds for dodging LEFT (Tight pivot to avoid the front)
  static const int DODGE_ARC_SLOW = 10; 
  static const int DODGE_ARC_FAST = 120;

  // Speeds for sweeping RIGHT (More forward momentum to clear the tail)
  static const int RETURN_ARC_SLOW = 70; 
  static const int RETURN_ARC_FAST = 130; 

  // Arc timing
  static const int STOP_TIME      = 400;
  static const int LEFT_ARC_TIME  = 750; // Increased to pull further past the object
  static const int RIGHT_ARC_TIME = 3500;
  unsigned long lastObstacleTime = 0;

  unsigned long turnStartTime = 0;
  bool isTurning = false;

  // ADDED: Counter to track the number of obstacles encountered
  int obstacleCount = 0; 

  enum AvoidState {
    IDLE,
    STOP_BEFORE_OBSTACLE,
    LEFT_ARC_AROUND,
    RIGHT_ARC_BACK,
    SEARCH_LINE,
    RECOVER_LINE,
    TURN_180 // ADDED: New state for turning around
  };

  AvoidState avoidState = IDLE;
  unsigned long avoidTimer = 0;

public:
  Car()
    : leftMotor (9,  4, 5)
    , rightMotor(10, 6, 7)
    , leftIR    (2)
    , rightIR   (3)
    , rightSonar(8, 11)
    , leftSonar (12, 13)
  {}

  void begin() {
    leftMotor.begin();
    rightMotor.begin();
    leftIR.begin();
    rightIR.begin();
    rightSonar.begin();
    leftSonar.begin();
    stop();
  }

 void update() {
    if (avoidState != IDLE) {
      handleObstacleAvoidance();
      return;
    }

    long distRight = rightSonar.getDistance();
    delay(25); 
    long distLeft  = leftSonar.getDistance();

    bool obstacleRight = (distRight > 0 && distRight <= STOP_DIST);
    bool obstacleLeft  = (distLeft  > 0 && distLeft  <= STOP_DIST);

    // Only count if we haven't seen an obstacle in the last 2 seconds (Debounce)
    if ((obstacleRight || obstacleLeft) && (millis() - lastObstacleTime > 2000)) {
      stop();
      lastObstacleTime = millis(); // Lock out the counter for 2 seconds
      
      obstacleCount++;
      
      if (obstacleCount >= 2) {
        avoidState = TURN_180;
      } else {
        avoidState = STOP_BEFORE_OBSTACLE;
      }
      
      avoidTimer = millis();
      isTurning = false;
      return;
    }
    followLine();
  }

private:
  void driveForward() {
    leftMotor.forward(SPEED);
    rightMotor.forward(SPEED);
  }

  void turnLeft() {
    leftMotor.forward(0);
    rightMotor.forward(SPEED);
  }

  void turnRight() {
    leftMotor.forward(SPEED);
    rightMotor.forward(0);
  }

  void spinLeft() {
    leftMotor.backward(TURN_SPEED);
    rightMotor.forward(SPEED);
  }

  void spinRight() {
    leftMotor.forward(SPEED);
    rightMotor.backward(TURN_SPEED);
  }

  void stop() {
    leftMotor.stop();
    rightMotor.stop();
  }

  // LEFT ARC: Tight dodge around the front
  void arcLeft() {
    leftMotor.forward(DODGE_ARC_SLOW);
    rightMotor.forward(DODGE_ARC_FAST);
  }

  // RIGHT ARC: Sweeping merge to pull the tail clear
  void arcRight() {
    leftMotor.forward(RETURN_ARC_FAST);
    rightMotor.forward(RETURN_ARC_SLOW);
  }

  bool blackLineDetected() {
    return !leftIR.onLine() || !rightIR.onLine();
  }

  // ─────────────────────────────────────
  // Normal line following
  // ─────────────────────────────────────
  void followLine() {
    bool L = leftIR.onLine();  // true = WHITE, false = BLACK
    bool R = rightIR.onLine(); // true = WHITE, false = BLACK

    if (L && R) {
      driveForward();
      isTurning = false;
    }

    else if (!L && R) {
      if (!isTurning) {
        turnStartTime = millis();
        isTurning = true;
      }

      if (millis() - turnStartTime > 100) {
        spinLeft();
      } else {
        turnLeft();
      }
    }

    else if (L && !R) {
      if (!isTurning) {
        turnStartTime = millis();
        isTurning = true;
      }

      if (millis() - turnStartTime > 100) {
        spinRight();
      } else {
        turnRight();
      }
    }

    else {
      driveForward();
      isTurning = false;
    }
  }

  // ─────────────────────────────────────
  // Obstacle avoidance:
  // stop → left arc → right arc → find line
  // ─────────────────────────────────────
  void handleObstacleAvoidance() {
    unsigned long elapsed = millis() - avoidTimer;

    switch (avoidState) {

      case STOP_BEFORE_OBSTACLE:
        stop();

        if (elapsed > STOP_TIME) {
          avoidState = LEFT_ARC_AROUND;
          avoidTimer = millis();
        }
        break;

      case LEFT_ARC_AROUND:
        {
          // Collision override. If the line curve brings the obstacle 
          // too close during the arc, push away aggressively.
          long currentDist = rightSonar.getDistance();
          if (currentDist > 0 && currentDist < 10) { 
            spinLeft(); 
          } else {
            arcLeft();  
          }

          if (elapsed > LEFT_ARC_TIME) {
            avoidState = RIGHT_ARC_BACK;
            avoidTimer = millis();
          }
        }
        break;

      case RIGHT_ARC_BACK:
        arcRight();

        // Dropped blind timer to 150ms. Grab the line instantly.
        if (elapsed > 150 && blackLineDetected()) {
          avoidState = RECOVER_LINE;
          stop();
          delay(200); // Small delay to maintain momentum control
          avoidTimer = millis();
          isTurning = false;
        }

        // Move to search mode quicker if we missed the line
        if (elapsed > 2500) {
          avoidState = SEARCH_LINE;
          avoidTimer = millis();
        }
        break;

      case SEARCH_LINE:
        arcRight();

        if (blackLineDetected()) {
          avoidState = RECOVER_LINE;
          stop();
          delay(200);
          avoidTimer = millis();
          isTurning = false;
        }

        // Failsafe. If it searches for 6 seconds, just stop so it 
        // doesn't drive off the table or do endless donuts.
        if (elapsed > 6000) {
          stop();
        }
        break;

      // ADDED: Case to handle turning 180 degrees
case TURN_180:
        spinLeft(); // Spin 180
        obstacleCount=0;
        // Spin blindly for at least 800ms to ensure we leave the old line
        // Then start looking for the line again
        if (elapsed > 1600 && blackLineDetected()) {
          avoidState = RECOVER_LINE;
          stop();
          delay(200); 
          avoidTimer = millis();
          isTurning = false;
        }

        // Failsafe: if for some reason it spins for a long time and misses the line
        if (elapsed > 8000) {
          avoidState = SEARCH_LINE;
          avoidTimer = millis();
        }
        break;

      case RECOVER_LINE:
        followLine();

        if (elapsed > 800) {
          avoidState = IDLE;
          isTurning = false;
        }
        break;

      case IDLE:
        break;
    }
  }
};

// ─────────────────────────────────────
// Main
// ─────────────────────────────────────
Car car;

void setup() {
  Serial.begin(9600);
  car.begin();

  unsigned long startTime = millis();
  while (millis() - startTime < 2000) {}
}

void loop() {
  car.update();
}
