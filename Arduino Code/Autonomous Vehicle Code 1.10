// ─────────────────────────────────────
// UltrasonicSensor
// ─────────────────────────────────────
class UltrasonicSensor {
  int trig, echo;

public:
  UltrasonicSensor(int trig, int echo) : trig(trig), echo(echo) {}

  void begin() {
    pinMode(trig, OUTPUT);
    pinMode(echo, INPUT);
  }

  long getDistance() {
    digitalWrite(trig, LOW);
    delayMicroseconds(2);
    digitalWrite(trig, HIGH);
    delayMicroseconds(10);
    digitalWrite(trig, LOW);
    long duration = pulseIn(echo, HIGH, 30000);
    return duration * 0.034 / 2;
  }
};

// ─────────────────────────────────────
// IRSensor
// ─────────────────────────────────────
class IRSensor {
  int pin;

public:
  IRSensor(int pin) : pin(pin) {}

  void begin() {
    pinMode(pin, INPUT);
  }

  bool onLine() {
    return digitalRead(pin) == LOW; 
  }
};

// ─────────────────────────────────────
// Motor
// ─────────────────────────────────────
class Motor {
  int en, in1, in2;

public:
  Motor(int en, int in1, int in2) : en(en), in1(in1), in2(in2) {}

  void begin() {
    pinMode(en,  OUTPUT);
    pinMode(in1, OUTPUT);
    pinMode(in2, OUTPUT);
  }

  void forward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  }

  void stop() {
    analogWrite(en, 0);
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }
};

// ─────────────────────────────────────
// Car
// ─────────────────────────────────────
class Car {
  Motor            leftMotor;
  Motor            rightMotor;
  IRSensor         leftIR;
  IRSensor         rightIR;
  
  // Dual Ultrasonic Sensors
  UltrasonicSensor rightSonar;
  UltrasonicSensor leftSonar; 

  // Tuning
  static const int SPEED      = 150;
  static const int TURN_SPEED = 80;
  static const int STOP_DIST  = 15; // Distance in cm to stop for obstacles

public:
  Car()
    : leftMotor (9,  4, 5)
    , rightMotor(10, 6, 7)
    , leftIR    (3)
    , rightIR   (2)
    , rightSonar(8, 11)   
    , leftSonar (12, 13)
  {}

  void begin() {
    leftMotor.begin();
    rightMotor.begin();
    leftIR.begin();
    rightIR.begin();
    rightSonar.begin();
    leftSonar.begin();
    stop();
  }

  void update() {
    // 1. Check for obstacles on both sides
    long distRight = rightSonar.getDistance();
    long distLeft = leftSonar.getDistance();
    
    // Check if either sensor detects a valid distance within the stopping threshold
    bool obstacleRight = (distRight > 0 && distRight <= STOP_DIST);
    bool obstacleLeft  = (distLeft > 0 && distLeft <= STOP_DIST);

    if (obstacleRight || obstacleLeft) {
      stop();
      return; // Exit early to avoid moving while blocked
    }

    // 2. If path is clear, follow the line
    followLine();
  }

private:
  void driveForward() {
    leftMotor.forward(SPEED);
    rightMotor.forward(SPEED);
  }

  void turnLeft() {
    leftMotor.forward(TURN_SPEED);
    rightMotor.forward(SPEED);
  }

  void turnRight() {
    leftMotor.forward(SPEED);
    rightMotor.forward(TURN_SPEED);
  }

  void stop() {
    leftMotor.stop();
    rightMotor.stop();
  }

  void followLine() {
    bool L = leftIR.onLine();
    bool R = rightIR.onLine();

    // Straddling logic: 
    // Both on white (!L && !R) -> Go straight
    if      (!L && !R) driveForward(); 
    
    // Left sensor hits the black line -> drifting right -> Turn Left to correct
    else if ( L && !R) turnLeft();     
    
    // Right sensor hits the black line -> drifting left -> Turn Right to correct
    else if (!L &&  R) turnRight();    
    
    // Both hit black (crossroad or lost) -> Stop
    else               stop();         
  }
};

// ─────────────────────────────────────
// Main
// ─────────────────────────────────────
Car car;

void setup() {
  Serial.begin(9600);
  car.begin();

  // Wait 2 seconds before moving
  unsigned long startTime = millis();
  while (millis() - startTime < 2000) {}
}

void loop() {
  car.update();
}
