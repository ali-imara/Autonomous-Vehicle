// ─────────────────────────────────────
// UltrasonicSensor
// ─────────────────────────────────────
class UltrasonicSensor {
  int trig, echo;

public:
  UltrasonicSensor(int trig, int echo) : trig(trig), echo(echo) {}

  void begin() {
    pinMode(trig, OUTPUT);
    pinMode(echo, INPUT);
  }

  long getDistance() {
    digitalWrite(trig, LOW);
    delayMicroseconds(2);
    digitalWrite(trig, HIGH);
    delayMicroseconds(10);
    digitalWrite(trig, LOW);

    long duration = pulseIn(echo, HIGH, 5000);

    if (duration == 0) {
      return 0;
    }

    return duration * 0.034 / 2;
  }
};

// ─────────────────────────────────────
// IRSensor
// ─────────────────────────────────────
class IRSensor {
  int pin;

public:
  IRSensor(int pin) : pin(pin) {}

  void begin() {
    pinMode(pin, INPUT);
  }

  // TRUE = WHITE
  // FALSE = BLACK
  bool onLine() {
    return digitalRead(pin) == LOW;
  }
};

// ─────────────────────────────────────
// Motor
// ─────────────────────────────────────
class Motor {
  int en, in1, in2;

public:
  Motor(int en, int in1, int in2) : en(en), in1(in1), in2(in2) {}

  void begin() {
    pinMode(en,  OUTPUT);
    pinMode(in1, OUTPUT);
    pinMode(in2, OUTPUT);
  }

  void forward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  }

  void backward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
  }

  void stop() {
    analogWrite(en, 0);
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }
};

// ─────────────────────────────────────
// Car
// ─────────────────────────────────────
class Car {
  Motor            leftMotor;
  Motor            rightMotor;
  IRSensor         leftIR;
  IRSensor         rightIR;
  UltrasonicSensor rightSonar;
  UltrasonicSensor leftSonar;

  // --- TUNING ---
  static const int SPEED      = 85;
  static const int TURN_SPEED = 55;
  static const int STOP_DIST  = 17;

  // Arc movement speeds
  static const int ARC_SLOW = 50;
  static const int ARC_FAST = 90;

  // Arc timing
  static const int STOP_TIME      = 400;
  static const int LEFT_ARC_TIME  = 650;
  static const int RIGHT_ARC_TIME = 3500;

  unsigned long turnStartTime = 0;
  bool isTurning = false;

  enum AvoidState {
    IDLE,
    STOP_BEFORE_OBSTACLE,
    LEFT_ARC_AROUND,
    RIGHT_ARC_BACK,
    SEARCH_LINE,
    RECOVER_LINE
  };

  AvoidState avoidState = IDLE;
  unsigned long avoidTimer = 0;

public:
  Car()
    : leftMotor (9,  4, 5)
    , rightMotor(10, 6, 7)
    , leftIR    (2)
    , rightIR   (3)
    , rightSonar(8, 11)
    , leftSonar (12, 13)
  {}

  void begin() {
    leftMotor.begin();
    rightMotor.begin();
    leftIR.begin();
    rightIR.begin();
    rightSonar.begin();
    leftSonar.begin();
    stop();
  }

  void update() {

    if (avoidState != IDLE) {
      handleObstacleAvoidance();
      return;
    }

    long distRight = rightSonar.getDistance();
    long distLeft  = leftSonar.getDistance();

    bool obstacleRight = (distRight > 0 && distRight <= STOP_DIST);
    bool obstacleLeft  = (distLeft  > 0 && distLeft  <= STOP_DIST);

    if (obstacleRight || obstacleLeft) {
      stop();
      avoidState = STOP_BEFORE_OBSTACLE;
      avoidTimer = millis();
      isTurning = false;
      return;
    }

    followLine();
  }

private:
  void driveForward() {
    leftMotor.forward(SPEED);
    rightMotor.forward(SPEED);
  }

  void turnLeft() {
    leftMotor.forward(0);
    rightMotor.forward(SPEED);
  }

  void turnRight() {
    leftMotor.forward(SPEED);
    rightMotor.forward(0);
  }

  void spinLeft() {
    leftMotor.backward(TURN_SPEED);
    rightMotor.forward(SPEED);
  }

  void spinRight() {
    leftMotor.forward(SPEED);
    rightMotor.backward(TURN_SPEED);
  }

  void stop() {
    leftMotor.stop();
    rightMotor.stop();
  }

  // LEFT ARC:
  // left motor slow, right motor fast
  // car curves left around the obstacle
  void arcLeft() {
    leftMotor.backward(ARC_SLOW);
    rightMotor.forward(ARC_FAST);
  }

  // RIGHT ARC:
  // left motor fast, right motor slow
  // car curves right back toward the line
  void arcRight() {
    leftMotor.forward(ARC_FAST);
    rightMotor.forward(ARC_SLOW);
  }

  bool blackLineDetected() {
    return !leftIR.onLine() || !rightIR.onLine();
  }

  // ─────────────────────────────────────
  // Normal line following
  // ─────────────────────────────────────
  void followLine() {
    bool L = leftIR.onLine();  // true = WHITE, false = BLACK
    bool R = rightIR.onLine(); // true = WHITE, false = BLACK

    if (L && R) {
      driveForward();
      isTurning = false;
    }

    else if (!L && R) {
      if (!isTurning) {
        turnStartTime = millis();
        isTurning = true;
      }

      if (millis() - turnStartTime > 185) {
        spinLeft();
      } else {
        turnLeft();
      }
    }

    else if (L && !R) {
      if (!isTurning) {
        turnStartTime = millis();
        isTurning = true;
      }

      if (millis() - turnStartTime > 185) {
        spinRight();
      } else {
        turnRight();
      }
    }

    else {
      driveForward();
      isTurning = false;
    }
  }

  // ─────────────────────────────────────
  // Obstacle avoidance:
  // stop → left arc → right arc → find line
  // ─────────────────────────────────────
  void handleObstacleAvoidance() {
    unsigned long elapsed = millis() - avoidTimer;

    switch (avoidState) {

      case STOP_BEFORE_OBSTACLE:
        stop();

        if (elapsed > STOP_TIME) {
          avoidState = LEFT_ARC_AROUND;
          avoidTimer = millis();
        }
        break;

      case LEFT_ARC_AROUND:
        // First part of the arc: move left around obstacle
        // Do NOT detect line here because sensors may still see old line
        arcLeft();

        if (elapsed > LEFT_ARC_TIME) {
          avoidState = RIGHT_ARC_BACK;
          avoidTimer = millis();
        }
        break;

      case RIGHT_ARC_BACK:
        // Second part of the arc: curve right back toward the original line
        arcRight();

        // Start detecting line after a small delay
        // so it does not instantly detect the old line
        if (elapsed > 500 && blackLineDetected()) {
          avoidState = RECOVER_LINE;
          stop();
          delay(150);
          avoidTimer = millis();
          isTurning = false;
        }

        // If line was not found yet, keep searching right
        if (elapsed > RIGHT_ARC_TIME) {
          avoidState = SEARCH_LINE;
          avoidTimer = millis();
        }
        break;

      case SEARCH_LINE:
        // Keep curving right until black line is found
        arcRight();

        if (blackLineDetected()) {
          avoidState = RECOVER_LINE;
          stop();
          delay(150);
          avoidTimer = millis();
          isTurning = false;
        }
        break;

      case RECOVER_LINE:
        // Let normal line following control the car again
        followLine();

        if (elapsed > 800) {
          avoidState = IDLE;
          isTurning = false;
        }
        break;

      case IDLE:
        break;
    }
  }
};

// ─────────────────────────────────────
// Main
// ─────────────────────────────────────
Car car;

void setup() {
  Serial.begin(9600);
  car.begin();

  unsigned long startTime = millis();
  while (millis() - startTime < 2000) {}
}

void loop() {
  car.update();
}
