// ─────────────────────────────────────
// UltrasonicSensor
// ─────────────────────────────────────
class UltrasonicSensor {
  int trig, echo;

public:
  UltrasonicSensor(int trig, int echo) : trig(trig), echo(echo) {}

  void begin() {
    pinMode(trig, OUTPUT);
    pinMode(echo, INPUT);
  }

  long getDistance() {
    digitalWrite(trig, LOW);
    delayMicroseconds(2);
    digitalWrite(trig, HIGH);
    delayMicroseconds(10);
    digitalWrite(trig, LOW);

    // Timeout reduced to 3000us (max distance ~50cm).
    // CRITICAL: Prevents the sensor from freezing the main loop!
    long duration = pulseIn(echo, HIGH, 3000);

    if (duration == 0) {
      return 0;
    }

    return duration * 0.034 / 2;
  }
};

// ─────────────────────────────────────
// IRSensor
// ─────────────────────────────────────
class IRSensor {
  int pin;

public:
  IRSensor(int pin) : pin(pin) {}

  void begin() {
    pinMode(pin, INPUT);
  }

  // TRUE = WHITE
  // FALSE = BLACK
  bool onLine() {
    return digitalRead(pin) == LOW;
  }
};

// ─────────────────────────────────────
// Motor
// ─────────────────────────────────────
class Motor {
  int en, in1, in2;

public:
  Motor(int en, int in1, int in2) : en(en), in1(in1), in2(in2) {}

  void begin() {
    pinMode(en,  OUTPUT);
    pinMode(in1, OUTPUT);
    pinMode(in2, OUTPUT);
  }

  void forward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  }

  void backward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
  }

  void stop() {
    analogWrite(en, 0);
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }
};

// ─────────────────────────────────────
// Car
// ─────────────────────────────────────
class Car {
  Motor            leftMotor;
  Motor            rightMotor;
  IRSensor         leftIR;
  IRSensor         rightIR;
  UltrasonicSensor rightSonar;
  UltrasonicSensor leftSonar;

  // --- TUNING ---
  // START AT 77, BUT YOU CAN LIKELY INCREASE THIS TO 120-150 NOW
  static const int SPEED      = 77; 
  static const int TURN_SPEED = 50;
  static const int STOP_DIST  = 17;

  // Speeds for dodging LEFT
  static const int DODGE_ARC_SLOW = 10; 
  static const int DODGE_ARC_FAST = 80;

  // Speeds for sweeping RIGHT
  static const int RETURN_ARC_SLOW = 48; 
  static const int RETURN_ARC_FAST = 90; 

  // Arc timing
  static const int STOP_TIME      = 400;
  static const int LEFT_ARC_TIME  = 660;
  static const int RIGHT_ARC_TIME = 3500;

  unsigned long lastObstacleTime = 0;

  // Line Following Timers & Flags
  unsigned long turnStartTime = 0;
  bool isTurning = false;
  unsigned long straightStartTime = 0;
  bool highMomentum = false;

  int obstacleCount = 0; 

  // Sonar Timers
  unsigned long lastSonarTime = 0;
  bool checkRightSonarNext = true;

  enum AvoidState {
    IDLE,
    STOP_BEFORE_OBSTACLE,
    LEFT_ARC_AROUND,
    RIGHT_ARC_BACK,
    SEARCH_LINE,
    RECOVER_LINE,
    TURN_180
  };

  AvoidState avoidState = IDLE;
  unsigned long avoidTimer = 0;

public:
  Car()
    : leftMotor (9,  4, 5)
    , rightMotor(10, 6, 7)
    , leftIR    (2)
    , rightIR   (3)
    , rightSonar(8, 11)
    , leftSonar (12, 13)
  {}

  void begin() {
    leftMotor.begin();
    rightMotor.begin();
    leftIR.begin();
    rightIR.begin();
    rightSonar.begin();
    leftSonar.begin();
    stop();
  }

  void update() {
    if (avoidState != IDLE) {
      handleObstacleAvoidance();
      return;
    }

    // ONLY check sonars every 100ms
    if (millis() - lastSonarTime > 100) {
      lastSonarTime = millis();

      long distRight = 0;
      long distLeft = 0;

      if (checkRightSonarNext) {
        distRight = rightSonar.getDistance();
      } else {
        distLeft = leftSonar.getDistance();
      }

      checkRightSonarNext = !checkRightSonarNext;

      bool obstacleRight = (distRight > 0 && distRight <= STOP_DIST);
      bool obstacleLeft  = (distLeft  > 0 && distLeft  <= STOP_DIST);

      // Only count if we haven't seen an obstacle in the last 2 seconds
      if ((obstacleRight || obstacleLeft) && (millis() - lastObstacleTime > 2000)) {
        stop();
        lastObstacleTime = millis();

        obstacleCount++;

        if (obstacleCount >= 2) {
          avoidState = TURN_180;
        } else {
          avoidState = STOP_BEFORE_OBSTACLE;
        }

        avoidTimer = millis();
        isTurning = false;
        highMomentum = false; // Reset momentum on obstacle detect
        return;
      }
    }

    followLine(); 
  }

private:
  void driveForward() {
    leftMotor.forward(SPEED);
    rightMotor.forward(SPEED);
  }

  // DRIFT: High-speed smooth adjustments (inner wheel keeps moving)
  void driftLeft() {
    leftMotor.forward(SPEED * 0.4); 
    rightMotor.forward(SPEED);
  }

  void driftRight() {
    leftMotor.forward(SPEED);
    rightMotor.forward(SPEED * 0.4); 
  }

  // TURN: Standard curve handling (inner wheel stops)
  void turnLeft() {
    leftMotor.forward(0);
    rightMotor.forward(SPEED);
  }

  void turnRight() {
    leftMotor.forward(SPEED);
    rightMotor.forward(0);
  }

  // SPIN: Sharp corners and emergency braking (inner wheel reverses)
  void spinLeft() {
    leftMotor.backward(TURN_SPEED);
    rightMotor.forward(SPEED);
  }

  void spinRight() {
    leftMotor.forward(SPEED);
    rightMotor.backward(TURN_SPEED);
  }

  void stop() {
    leftMotor.stop();
    rightMotor.stop();
  }

  // LEFT ARC (Obstacle)
  void arcLeft() {
    leftMotor.forward(DODGE_ARC_SLOW);
    rightMotor.forward(DODGE_ARC_FAST);
  }

  // RIGHT ARC (Obstacle)
  void arcRight() {
    leftMotor.forward(RETURN_ARC_FAST);
    rightMotor.forward(RETURN_ARC_SLOW);
  }

  bool blackLineDetected() {
    return !leftIR.onLine() || !rightIR.onLine();
  }

  // ─────────────────────────────────────
  // High-Speed Momentum Line Following
  // ─────────────────────────────────────
  void followLine() {
    bool L = leftIR.onLine();  // true = WHITE
    bool R = rightIR.onLine(); // true = WHITE

    // ─── PERFECTLY CENTERED (DRIVING STRAIGHT) ───
    if (L && R) {
      if (isTurning) {
        straightStartTime = millis(); 
        isTurning = false;
      }
      
      driveForward();

      // If we've been going straight for 400ms, arm the emergency brake!
      if (millis() - straightStartTime > 400) {
        highMomentum = true;
      }
    }

    // ─── VEERING RIGHT, NEED TO TURN LEFT ───
    else if (!L && R) {
      if (!isTurning) {
        turnStartTime = millis();
        isTurning = true;
      }

      unsigned long turnDuration = millis() - turnStartTime;

      if (highMomentum) {
        spinLeft(); // EMERGENCY BRAKE
        if (turnDuration > 100) highMomentum = false; 
      } else {
        if (turnDuration < 30) {
          driftLeft();
        } else if (turnDuration < 90) {
          turnLeft();
        } else {
          spinLeft();
        }
      }
    }

    // ─── VEERING LEFT, NEED TO TURN RIGHT ───
    else if (L && !R) {
      if (!isTurning) {
        turnStartTime = millis();
        isTurning = true;
      }

      unsigned long turnDuration = millis() - turnStartTime;

      if (highMomentum) {
        spinRight(); // EMERGENCY BRAKE
        if (turnDuration > 100) highMomentum = false; 
      } else {
        if (turnDuration < 60) {
          driftRight();
        } else if (turnDuration < 180) {
          turnRight();
        } else {
          spinRight();
        }
      }
    }

    // ─── BOTH BLACK (Intersection) ───
    else {
      driveForward();
      isTurning = false;
      straightStartTime = millis(); // Reset timer
      highMomentum = false;
    }
  }

  // ─────────────────────────────────────
  // Obstacle avoidance
  // ─────────────────────────────────────
  void handleObstacleAvoidance() {
    unsigned long elapsed = millis() - avoidTimer;

    switch (avoidState) {

      case STOP_BEFORE_OBSTACLE:
        stop();

        if (elapsed > STOP_TIME) {
          avoidState = LEFT_ARC_AROUND;
          avoidTimer = millis();
        }
        break;

      case LEFT_ARC_AROUND:
        {
          long currentDist = rightSonar.getDistance();

          if (currentDist > 0 && currentDist < 10) { 
            spinLeft(); 
          } else {
            arcLeft();  
          }

          if (elapsed > LEFT_ARC_TIME) {
            avoidState = RIGHT_ARC_BACK;
            avoidTimer = millis();
          }
        }
        break;

      case RIGHT_ARC_BACK:
        arcRight();

        if (elapsed > 150 && blackLineDetected()) {
          spinLeft();
          delay(150);     
          stop();
          delay(250);     

          avoidState = RECOVER_LINE;
          avoidTimer = millis();
          isTurning = false;
          break;
        }

        if (elapsed > 2500) {
          avoidState = SEARCH_LINE;
          avoidTimer = millis();
        }
        break;

      case SEARCH_LINE:
        arcRight();

        if (blackLineDetected()) {
          spinLeft();
          delay(150);     
          stop();
          delay(250);     

          avoidState = RECOVER_LINE;
          avoidTimer = millis();
          isTurning = false;
          break;
        }

        if (elapsed > 6000) {
          stop();
        }
        break;

      case TURN_180:
        spinLeft();
        obstacleCount = 0;

        if (elapsed > 1600 && blackLineDetected()) {
          stop();
          delay(300);     

          avoidState = RECOVER_LINE;
          avoidTimer = millis();
          isTurning = false;
          break;
        }

        if (elapsed > 8000) {
          avoidState = SEARCH_LINE;
          avoidTimer = millis();
        }
        break;

      case RECOVER_LINE:
        followLine();

        if (elapsed > 150) {
          avoidState = IDLE;
          isTurning = false;
          
          // CRITICAL: Reset momentum variables after dodging
          // so it doesn't emergency brake by mistake!
          highMomentum = false;
          straightStartTime = millis(); 
        }
        break;

      case IDLE:
        break;
    }
  }
};

// ─────────────────────────────────────
// Main
// ─────────────────────────────────────
Car car;

void setup() {
  Serial.begin(9600);
  car.begin();

  unsigned long startTime = millis();
  while (millis() - startTime < 2000) {}
}

void loop() {
  car.update();
}
