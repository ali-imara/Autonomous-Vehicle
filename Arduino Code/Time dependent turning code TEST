// ─────────────────────────────────────
// UltrasonicSensor
// ─────────────────────────────────────
class UltrasonicSensor {
  int trig, echo;

public:
  UltrasonicSensor(int trig, int echo) : trig(trig), echo(echo) {}

  void begin() {
    pinMode(trig, OUTPUT);
    pinMode(echo, INPUT);
  }

  long getDistance() {
    digitalWrite(trig, LOW);
    delayMicroseconds(2);
    digitalWrite(trig, HIGH);
    delayMicroseconds(10);
    digitalWrite(trig, LOW);
    long duration = pulseIn(echo, HIGH, 30000);
    return duration * 0.034 / 2;
  }
};

// ─────────────────────────────────────
// IRSensor
// ─────────────────────────────────────
class IRSensor {
  int pin;

public:
  IRSensor(int pin) : pin(pin) {}

  void begin() {
    pinMode(pin, INPUT);
  }

  // Returns TRUE when on WHITE (LOW), FALSE when on BLACK (HIGH)
  bool onLine() {
    return digitalRead(pin) == LOW;  
  }
};

// ─────────────────────────────────────
// Motor
// ─────────────────────────────────────
class Motor {
  int en, in1, in2;

public:
  Motor(int en, int in1, int in2) : en(en), in1(in1), in2(in2) {}

  void begin() {
    pinMode(en,  OUTPUT);
    pinMode(in1, OUTPUT);
    pinMode(in2, OUTPUT);
  }

  void forward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  }

  void backward(int speed) {
    analogWrite(en, speed);
    digitalWrite(in1, LOW);   
    digitalWrite(in2, HIGH);   
  }

  void stop() {
    analogWrite(en, 0);
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }
};

// ─────────────────────────────────────
// Car
// ─────────────────────────────────────
class Car {
  Motor            leftMotor;
  Motor            rightMotor;
  IRSensor         leftIR;
  IRSensor         rightIR;
  UltrasonicSensor rightSonar;
  UltrasonicSensor leftSonar; 

  static const int SPEED      = 100; 
  static const int TURN_SPEED = 70; 
  static const int STOP_DIST  = 15;  

  unsigned long turnStartTime = 0;
  bool isTurning = false;

public:
  Car()
    : leftMotor (9,  4, 5)
    , rightMotor(10, 6, 7)
    , leftIR    (3)
    , rightIR   (2)
    , rightSonar(8, 11)   
    , leftSonar (12, 13)  
  {}

  void begin() {
    leftMotor.begin();
    rightMotor.begin();
    leftIR.begin();
    rightIR.begin();
    rightSonar.begin();
    leftSonar.begin();
    stop();
  }

  void update() {
    long distRight = rightSonar.getDistance();
    long distLeft = leftSonar.getDistance();
    
    bool obstacleRight = (distRight > 0 && distRight <= STOP_DIST);
    bool obstacleLeft  = (distLeft > 0 && distLeft <= STOP_DIST);

    if (obstacleRight || obstacleLeft) {
      stop();
      return; 
    }

    followLine();
  }

private:
  void driveForward() {
    leftMotor.forward(SPEED);
    rightMotor.forward(SPEED);
  }

  //  NORMAL TURNS 
  void turnLeft() {
    leftMotor.stop();             
    rightMotor.forward(SPEED);    
  }

  void turnRight() {
    leftMotor.forward(SPEED);     
    rightMotor.stop();            
  }

  //  SHARP CORNERS 
  void spinLeft() {
    leftMotor.backward(TURN_SPEED); 
    rightMotor.forward(SPEED);      
  }

  void spinRight() {
    leftMotor.forward(SPEED);       
    rightMotor.backward(TURN_SPEED);
  }

  void stop() {
    leftMotor.stop();
    rightMotor.stop();
  }

  void followLine() {
    bool L = leftIR.onLine(); // true = White, false = Black
    bool R = rightIR.onLine(); // true = White, false = Black

    // 1. Both on white -> Straddling perfectly
    if (L && R) {
      driveForward(); 
      isTurning = false; // Reset the turn tracker
    } 
    // 2. Left sensor hits black -> Drifting right, need to turn left
    else if (!L && R) {
      if (!isTurning) {
        turnStartTime = millis(); // Start stopwatch
        isTurning = true;
      }
      
      // If turning for more than 100ms, escalate to sharp spin
      if (millis() - turnStartTime > 300) {
        spinRight(); 
      } else {
        turnRight(); 
      }
    } 
    // 3. Right sensor hits black -> Drifting left, need to turn right
    else if (L && !R) {
      if (!isTurning) {
        turnStartTime = millis(); // Start stopwatch
        isTurning = true;
      }
      
      // If turning for more than 100ms, escalate to sharp spin
      if (millis() - turnStartTime > 300) {
        spinLeft(); 
      } else {
        turnLeft(); 
      }
    }
  }
};

// ─────────────────────────────────────
// Main
// ─────────────────────────────────────
Car car;

void setup() {
  Serial.begin(9600);
  car.begin();

  unsigned long startTime = millis();
  while (millis() - startTime < 2000) {}
}

void loop() {
  car.update();
}
