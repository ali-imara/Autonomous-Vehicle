        <mxCell id="r21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;" value="«requirement»&lt;br&gt;REQ-002-1&lt;br&gt;The system shall use &lt;strong data-start=&quot;1228&quot; data-end=&quot;1250&quot;&gt;the left IR sensor&lt;/strong&gt; for line tracking.&lt;div&gt;&lt;br&gt;Id = &quot;REQ-002-1&quot;&lt;br&gt;Priority = Medium&lt;/div&gt;" vertex="1">
