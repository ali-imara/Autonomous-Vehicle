  <diagram name="Autonomous Vehicle Requirements" id="updated-req">
    <mxGraphModel dx="1467" dy="892" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1050" math="0" shadow="0">
